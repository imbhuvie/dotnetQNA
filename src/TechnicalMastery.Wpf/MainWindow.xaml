<Window x:Class="TechnicalMastery.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TechnicalMastery.Wpf.ViewModels"
        xmlns:views="clr-namespace:TechnicalMastery.Wpf.Views"
        Title=".NET Technical Mastery" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowseViewModel}">
            <views:BrowseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuestionDetailViewModel}">
            <views:QuestionDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BookmarksViewModel}">
            <views:BookmarksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgressViewModel}">
            <views:ProgressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotesViewModel}">
            <views:NotesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}">
            <views:AboutView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation: buttons bound to commands, no click handlers. -->
        <StackPanel Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <TextBlock Text=".NET Mastery" Foreground="{DynamicResource SidebarForegroundBrush}" FontSize="18" FontWeight="Bold"
                       Margin="16,16,16,8" />
            <TextBlock Text="Technical Q&amp;A" Foreground="{DynamicResource SidebarForegroundBrush}" Opacity="0.6" FontSize="12"
                       Margin="16,0,16,16" />
            <Button Content="Dashboard" Command="{Binding NavigateToDashboardCommand}" Margin="8,2" Padding="8,6" />
            <Button Content="Browse" Command="{Binding NavigateToBrowseCommand}" Margin="8,2" Padding="8,6" />
            <Button Content="Bookmarks" Command="{Binding NavigateToBookmarksCommand}" Margin="8,2" Padding="8,6" />
            <Button Content="Progress" Command="{Binding NavigateToProgressCommand}" Margin="8,2" Padding="8,6" />
            <Button Content="Notes" Command="{Binding NavigateToNotesCommand}" Margin="8,2" Padding="8,6" />
            <Button Content="Settings" Command="{Binding NavigateToSettingsCommand}" Margin="8,2" Padding="8,6" />
            <Button Content="About" Command="{Binding NavigateToAboutCommand}" Margin="8,2" Padding="8,6" />
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with global search. -->
            <DockPanel Grid.Row="0" Margin="12,8">
                <Button Content="Search" Command="{Binding SearchCommand}" DockPanel.Dock="Right"
                        Padding="12,4" Margin="8,0,0,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,4" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <!-- Hosted screen. -->
            <ContentControl Grid.Row="1" Content="{Binding Navigation.CurrentViewModel}" Margin="12,0,12,12" />
        </Grid>
    </Grid>
</Window>
