<UserControl x:Class="TechnicalMastery.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="900">
            <TextBlock Text=".NET Technical Mastery" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Study dashboard" FontSize="14" Opacity="0.7" Margin="0,0,0,12" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <TextBlock Text="Loading..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Headline stats. -->
            <WrapPanel Margin="0,0,0,12">
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding TotalQuestions}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Total questions" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Completed" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding RemainingCount}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Remaining" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding BookmarkCount}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Bookmarks" Opacity="0.7" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8" MinWidth="130">
                    <StackPanel>
                        <TextBlock Text="{Binding NeedsReviewCount}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Needs review" Opacity="0.7" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Button Content="Continue Learning" Command="{Binding ContinueLearningCommand}"
                    Padding="16,8" HorizontalAlignment="Left" Margin="0,0,0,16" />

            <TextBlock Text="Categories" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding CategoryName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PercentComplete}"
                                         Height="14" Margin="8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                <Run Text="{Binding Completed}" /><Run Text="/" /><Run Text="{Binding Total}" />
                                <Run Text="(" /><Run Text="{Binding PercentComplete}" /><Run Text="%)" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
