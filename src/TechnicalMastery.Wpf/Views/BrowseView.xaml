<UserControl x:Class="TechnicalMastery.Wpf.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Filters. -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock Text="Category" FontWeight="Bold" />
            <ListBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedCategory}" Height="150" Margin="0,4,0,0">
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CategoryChangedCommand}" />
                </ListBox.InputBindings>
            </ListBox>
            <Button Content="Apply category" Command="{Binding CategoryChangedCommand}" Margin="0,4,0,12" />

            <TextBlock Text="Topic" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding Topics}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedTopic}" Margin="0,4,0,12" />

            <TextBlock Text="Difficulty" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}"
                      Margin="0,4,0,12" />

            <TextBlock Text="Sort by" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                      Margin="0,4,0,12" />
            <Button Content="Apply filters" Command="{Binding FilterChangedCommand}" />
        </StackPanel>

        <!-- Question list. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button Content="Search" Command="{Binding SearchCommand}" DockPanel.Dock="Right"
                        Padding="12,4" Margin="8,0,0,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,32,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Questions}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                HorizontalContentAlignment="Stretch" Padding="8" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="{Binding QuestionText}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.7" TextWrapping="Wrap">
                                    <Run Text="{Binding CategoryName}" /><Run Text=" / " /><Run Text="{Binding TopicName}" />
                                    <Run Text="  •  " /><Run Text="{Binding DifficultyLevel}" />
                                    <Run Text="  •  " /><Run Text="{Binding Status}" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" Padding="12,4" Margin="0,0,8,0" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Page " /><Run Text="{Binding Page}" /><Run Text=" of " /><Run Text="{Binding TotalPages}" />
                    <Run Text=" (" /><Run Text="{Binding TotalCount}" /><Run Text=" questions)" />
                </TextBlock>
                <Button Content="Next ›" Command="{Binding NextPageCommand}" Padding="12,4" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
