<UserControl x:Class="TechnicalMastery.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="700">
            <TextBlock Text="{Binding AppTitle}" FontSize="26" FontWeight="Bold" />
            <TextBlock FontSize="14" Opacity="0.7" Margin="0,0,0,12">
                <Run Text="Version " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="ARCHITECTURE" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.9">
                WPF (MVVM) → HTTP + JSON → ASP.NET Core API → Application services →
                EF Core repositories → SQLite. This client never touches the database;
                every screen above is a thin HTTP consumer of documented endpoints.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
