<UserControl x:Class="TechnicalMastery.Wpf.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="900">
            <TextBlock Text="My Notes" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="All personal notes, newest first. New notes are added from the question reader."
                       FontSize="14" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <TextBlock Text="Loading..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

            <ItemsControl ItemsSource="{Binding Notes}"
                          Visibility="{Binding Notes.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="Question #" /><Run Text="{Binding QuestionId, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                <TextBlock Opacity="0.7" FontSize="12">
                                    <Run Text="Updated " /><Run Text="{Binding UpdatedAt, Converter={StaticResource DateTimeToStringConverter}, Mode=OneWay}" />
                                </TextBlock>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Open question"
                                            Command="{Binding DataContext.OpenQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Edit"
                                            Command="{Binding DataContext.StartEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="10,4" Margin="0,0,8,0" />
                                    <Button Content="Delete"
                                            Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="10,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding EditingNote, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock FontWeight="Bold">
                        <Run Text="Editing note for Question #" /><Run Text="{Binding EditingNote.QuestionId, Mode=OneWay}" />
                    </TextBlock>
                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,4" Margin="0,8,0,4" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" />
                    <WrapPanel>
                        <Button Content="Save" Command="{Binding SaveEditCommand}" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Cancel" Command="{Binding CancelEditCommand}" Padding="10,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="No notes yet. Open any question and add a note from the reader."
                       Opacity="0.6" Margin="0,16,0,0"
                       Visibility="{Binding Notes.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
