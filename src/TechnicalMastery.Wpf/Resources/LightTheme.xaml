<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackground">#FFFFFF</Color>
    <Color x:Key="AppForeground">#1A1A1A</Color>
    <Color x:Key="CardBorder">#B0B0B0</Color>
    <Color x:Key="MutedForeground">#5A5A5A</Color>
    <Color x:Key="Accent">#0D6EFD</Color>
    <Color x:Key="CodeBackground">#1E1E2E</Color>
    <Color x:Key="CodeForeground">#DCDCAA</Color>
    <Color x:Key="SidebarBackground">#1E1E2E</Color>
    <Color x:Key="SidebarForeground">#FFFFFF</Color>
    <Color x:Key="TagBackground">#E8E8F0</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="{StaticResource AppForeground}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForeground}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="{StaticResource CodeBackground}" />
    <SolidColorBrush x:Key="CodeForegroundBrush" Color="{StaticResource CodeForeground}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackground}" />
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="{StaticResource SidebarForeground}" />
    <SolidColorBrush x:Key="TagBackgroundBrush" Color="{StaticResource TagBackground}" />
</ResourceDictionary>
